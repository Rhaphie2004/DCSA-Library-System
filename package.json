{
  "name": "dcsa-library-system",
  "version": "1.0.0",
  "private": true,
  "description": "Offline library circulation and inventory for DCSA",
  "author": "DCSA Library",
  "license": "UNLICENSED",
  "main": "app/main.js",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:desktop": "node scripts/desktop-check.js",
    "pack": "electron-builder --dir --win --x64",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "edu.dcsa.library",
    "productName": "DCSA Library",
    "files": [
      "app/**",
      "HTML/**",
      "CSS/**",
      "JS/**",
      "dcsa.png",
      "README.md"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
